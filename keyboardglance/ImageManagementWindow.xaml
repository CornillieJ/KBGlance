<Window x:Class="keyboardglance.ImageManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:keyboardglance"
        mc:Ignorable="d"
        Title="Image management" Height="800" Width="800"
        Background="Transparent" Foreground="White" AllowsTransparency="True" WindowStyle="None">
    <Grid>
        <GroupBox x:Name="grpOutline" Header="Image manager" FontSize="16" Margin="0" Padding="0"
                  Background="#FF202030" MouseDown="UIElement_OnMouseDown">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical">
                        <Label Foreground="white">Current images:</Label>
                        <ScrollViewer>
                            <StackPanel x:Name="stkImages">
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="btnImageFolder" Content="Open image folder" Width="150" Padding="0"
                                Background="DarkSlateGray" Foreground="White"
                                Margin="0,5,0,0" Click="BtnImageFolder_OnClick" />
                        <Button x:Name="btnFindImages" Content="Force image reload" Width="150" Padding="0"
                                Background="DarkSlateGray" Foreground="White"
                                Margin="0,5,0,0" Click="BtnFindImages_OnClick" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="btnClose" Content="Close image manager" Width="170" Height="26" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="DarkSlateGray" Foreground="White"
                        Margin="0,5,0,0" Click="BtnClose_OnClick" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>